msgid "Finding your perfect meal…"
msgstr "Βρίσκουμε το ιδανικό γεύμα…"

msgid "Something went wrong. Please try again."
msgstr "Κάτι πήγε στραβά. Δοκιμάστε ξανά."

msgid "Location permission was denied. Enter a city instead."
msgstr "Η τοποθεσία δεν επιτράπηκε. Εισάγετε μια πόλη."

msgid "Could not detect your location. Enter a city instead."
msgstr "Δεν βρέθηκε η τοποθεσία σας. Εισάγετε μια πόλη."

msgid "Location request timed out. Try again or enter a city."
msgstr "Έληξε ο χρόνος αναμονής. Δοκιμάστε ξανά ή βάλτε πόλη."

msgid "Please enter a city or use your current location."
msgstr "Εισάγετε πόλη ή χρησιμοποιήστε την τρέχουσα τοποθεσία."

msgid "Current weather"
msgstr "Τρέχων καιρός"

msgid "No direct matches from your list — see optional extras."
msgstr "Δεν ταιριάζουν υλικά από τη λίστα σας — δείτε τα προαιρετικά."

