msgstr "Όριο ζεστού καιρού (°C)"

msgid "Mild temperature threshold (°C)"
msgstr "Όριο ήπιου καιρού (°C)"

msgid "Wind speed threshold (km/h)"
msgstr "Όριο ταχύτητας ανέμου (km/h)"

msgid "Wind rule max temperature (°C)"
msgstr "Μέγ. θερμοκρασία κανόνα ανέμου (°C)"

